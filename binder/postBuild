#!/bin/bash
# Post-build script for Binder
# Single Source of Truth: pyproject.toml + uv.lock (dependencies)
#
# This script mirrors the setup from .agents/reproduce/docker/setup.sh but adapted for Binder's
# conda-based environment where we install into the system Python rather than a venv.

set -euo pipefail

# Clean up the temp requirements file no matter how we exit so the failure
# message points at the real problem (e.g. uv export) rather than the cleanup.
trap 'rm -f /tmp/requirements.txt' EXIT

echo "🚀 Setting up Method of Moderation Binder environment..."

# Binder clones the repo to the user's home directory
REPO_DIR="${HOME}"

# Node.js 22 is installed via environment.yml (conda)
echo "✓ Node.js $(node --version)"
echo "✓ npm $(npm --version)"

# ============================================================================
# Install uv package manager (pinned for reproducibility)
# ============================================================================
echo "📦 Installing uv..."

# Pin uv version for reproducible builds
# Update this version periodically to get bug fixes and new features
pip install "uv>=0.5,<1.0"

echo "✓ uv $(uv --version)"

# ============================================================================
# Install dependencies from pyproject.toml using locked versions
# ============================================================================
echo "🐍 Installing Python dependencies from pyproject.toml..."

cd "${REPO_DIR}"

# Export locked dependencies to requirements.txt format
# This respects [tool.uv.sources] and ensures reproducible builds
uv export --frozen --no-hashes --no-dev -o /tmp/requirements.txt

# Install the exported requirements into the system Python
uv pip install --system -r /tmp/requirements.txt

# Note: We don't install the project in editable mode because the repo has a
# flat layout with multiple top-level directories (code/, binder/, content/, .agents/reproduce/).
# Instead, we add code/ to PYTHONPATH below, which makes the moderation module importable.
# /tmp/requirements.txt is cleaned up by the EXIT trap above.

# ============================================================================
# Configure environment
# ============================================================================
echo "⚙️ Configuring environment..."

# Set PYTHONPATH to include code/ directory
# This is added to the kernel's environment
mkdir -p ~/.ipython/profile_default/startup
cat > ~/.ipython/profile_default/startup/00-pythonpath.py << 'PYEOF'
import os
import sys

# Add code/ directory to Python path (Binder clones to home directory)
repo_dir = os.environ.get('HOME', '/home/jovyan')
code_dir = os.path.join(repo_dir, 'code')
if os.path.isdir(code_dir):
    if code_dir not in sys.path:
        sys.path.insert(0, code_dir)
else:
    print(
        f"WARNING: Expected code directory not found: {code_dir}. "
        "Notebook cells that `import moderation` will fail until this is "
        "fixed (check that Binder cloned the repository to $HOME)."
    )
PYEOF

# Also set for shell sessions
# shellcheck disable=SC2016  # Single quotes are intentional - variables expand at runtime
echo 'export PYTHONPATH="${HOME}/code:${PYTHONPATH}"' >> ~/.bashrc

# ============================================================================
# Warm up caches (non-critical, failures are logged but don't stop the build)
# ============================================================================
echo "🔥 Warming up caches..."

# Generate matplotlib font cache
if python -c "import matplotlib as mpl; mpl.use('Agg'); import pylab as plt; fig, ax = plt.subplots(); fig.savefig('/tmp/test.png')" 2>&1; then
    echo "✓ Matplotlib font cache generated"
else
    echo "⚠️ Matplotlib cache warmup failed (non-critical, first plot may be slow)"
fi
rm -f /tmp/test.png

# Pre-compile numba functions (optional, reduces first-run time)
if python -c "from moderation import IndShockMoMConsumerType; print('✓ Numba JIT compiled')" 2>&1; then
    : # Success message printed by Python
else
    echo "⚠️ Numba warmup skipped (first run may be slower)"
fi

# ============================================================================
# Verify installation
# ============================================================================
echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "✅ Binder environment ready!"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""
echo "   Python:  $(python --version)"
echo "   Node.js: $(node --version)"
myst_version=$(myst --version 2>&1) && echo "   MyST:    $myst_version" || echo "   MyST:    not available"
echo ""

# Hard-fail if any of the core packages fail to import. A Binder image where
# `import HARK` raises is worse than a build failure: users will hit it from
# inside a Jupyter session with no ability to reinstall, so the build itself
# must refuse to publish such an image.
echo "Verifying critical package imports..."
python -c "
import HARK; print(f'   HARK:    {HARK.__version__}')
import numpy; print(f'   NumPy:   {numpy.__version__}')
import scipy; print(f'   SciPy:   {scipy.__version__}')
import matplotlib; print(f'   Matplotlib: {matplotlib.__version__}')
" || {
    echo "" >&2
    echo "❌ FATAL: Critical package imports failed; Binder environment is broken." >&2
    echo "   Refusing to publish a non-functional image." >&2
    exit 1
}

echo ""
